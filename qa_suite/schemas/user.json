{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.json",
  "title": "User",
  "type": "object",
  "required": ["id", "username"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "username": {"type": "string", "minLength": 3, "maxLength": 32}
  }
}
