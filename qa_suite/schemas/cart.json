{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cart.json",
  "title": "Cart",
  "type": "object",
  "required": ["items", "subtotal_cents", "discount_cents", "total_cents"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["book_id", "title", "quantity", "unit_price_cents", "line_total_cents"],
        "additionalProperties": false,
        "properties": {
          "book_id": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 99},
          "unit_price_cents": {"type": "integer", "minimum": 0},
          "line_total_cents": {"type": "integer", "minimum": 0}
        }
      }
    },
    "subtotal_cents": {"type": "integer", "minimum": 0},
    "discount_cents": {"type": "integer", "minimum": 0},
    "total_cents": {"type": "integer", "minimum": 0}
  }
}
