{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.json",
  "title": "Order",
  "type": "object",
  "required": ["id", "subtotal_cents", "discount_cents", "total_cents", "created_at", "items"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "subtotal_cents": {"type": "integer", "minimum": 0},
    "discount_cents": {"type": "integer", "minimum": 0},
    "total_cents": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["book_id", "title", "quantity", "unit_price_cents"],
        "additionalProperties": false,
        "properties": {
          "book_id": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1},
          "unit_price_cents": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
