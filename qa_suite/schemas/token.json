{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "token.json",
  "title": "Access token",
  "type": "object",
  "required": ["access_token", "token_type"],
  "additionalProperties": false,
  "properties": {
    "access_token": {"type": "string", "minLength": 32},
    "token_type": {"const": "bearer"}
  }
}
